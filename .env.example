# Database
DATABASE_URL=svelteforge.db

# Application URL (set before building; used for SvelteKit paths.origin and Better Auth)
ORIGIN=http://localhost:5173

# Signs session cookies. Required in production; generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional: also append auth emails (password-reset links, …) to this JSONL file.
# Emails are always logged to the console until you connect a provider in
# src/lib/server/email.ts.
# AUTH_EMAIL_OUTBOX=.svelte-kit/outbox.jsonl

# OAuth Providers (all optional — omit to disable social login)

# Google OAuth 2.0
# Create at: https://console.cloud.google.com/apis/credentials
# Set redirect URI to: {ORIGIN}/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub OAuth
# Create at: https://github.com/settings/developers
# Set callback URL to: {ORIGIN}/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
